# Quant All-in-One 运行配置
# 本文件会映射到宿主机 web/.env，修改后重启容器即可生效。

# --------------------
# 通用
# --------------------
TZ="Asia/Shanghai"

# All-in-One 镜像和唯一对外端口
QUANT_IMAGE="drchzy/quant:latest"
WEB_PORT="8088"

# 数据库文件统一放在 web/data/
MARKET_DATABASE_FILE="market.duckdb"
SELECT_DATABASE_FILE="select.duckdb"
TRADE_DATABASE_FILE="trade.duckdb"

# --------------------
# market-data 行情服务
# --------------------
SYNC_ENABLED="true"
# 外部采集桥接写入令牌：至少 16 字符；留空时所有导入 API 禁用。
# 请自行设置随机长字符串，千万不要提交真实令牌到仓库。
BRIDGE_IMPORT_TOKEN=""
DAILY_SYNC_CRON="10 16 * * 1-5"
EASTMONEY_TIMEOUT_MS="10000"

# 东财所有请求统一串行限速，避免 push2 / push2his 触发 IP 风控。
EASTMONEY_MIN_INTERVAL_MS="1000"
EASTMONEY_RETRY_COUNT="2"
EASTMONEY_RETRY_BASE_MS="1500"

# push2delay 单页按100条最稳。
EASTMONEY_PAGE_SIZE="100"

# 页面实时数据缓存，避免重复刷新直接请求东财。
MARKET_CACHE_TTL_MS="60000"
SECTOR_CACHE_TTL_MS="300000"
QUOTE_CACHE_TTL_MS="5000"
TREND_CACHE_TTL_MS="10000"

# 腾讯备用源限速与重试。
FALLBACK_MIN_INTERVAL_MS="300"
FALLBACK_RETRY_COUNT="1"
FALLBACK_RETRY_BASE_MS="500"

# 可选：Tushare Pro Token。
# 留空时 Web 会显示“Tushare 未配置”，不会参与同步。
TUSHARE_TOKEN=""

# --------------------
# GDD 行情服务：仅需填写账号密码，不配置固定行情服务器IP。
# 首次访问时程序自动生成设备号，保存在 web/data/.gdd-device-id。
# 随后每次刷新会登录并通过 query_server_info 动态查找 serverType=36。
# 请勿将填有真实账号密码的 web/.env 提交至 GitHub。
GDD_ACCOUNT=""
GDD_PASSWORD=""
# 默认业务登录地址在代码中；以下仅用于特殊部署，不必修改。
# GDD_BUSINESS_URL="http://120.76.229.148:1080"
# GDD_TIMEOUT_MS="12000"

# --------------------
# GDD MCP Server（默认关闭，使用独立访问令牌）
# 开启时设置至少32字符随机Token，例如 openssl rand -hex 32。
# 不要复用GDD密码、BRIDGE_IMPORT_TOKEN或将令牌提交到GitHub。
GDD_MCP_TOKEN=""
# MCP默认拒绝携带Origin的浏览器跨域调用，如有合法网页客户端，
# 可逗号分隔增加可信站点，例如 https://mcp.example.com。
GDD_MCP_ALLOWED_ORIGINS=""
# GDD旧F10/资讯来自 ServerManager.getServerPath()，当前未能从下发清单确认基址。
# 只有你拿到准确地址后才配置（否则相关MCP工具明确报错，不乱猜地址）。
GDD_INFO_BASE_URL=""

# --------------------
# stock-select 选股服务
# --------------------
AUTO_SELECT_ENABLED="true"
SELECT_CRON="40 16 * * 1-5"

SELECT_TOP_COUNT="10"
SELECT_MAIN_COUNT="3"

# 默认排除：北交所、科创板、ST/退市；创业板保留。
SELECT_EXCLUDE_BSE="true"
SELECT_EXCLUDE_STAR="true"
SELECT_EXCLUDE_ST="true"

SELECT_MIN_PRICE="3"
SELECT_MIN_AMOUNT="100000000"
SELECT_MIN_MARKET_CAP="2000000000"
SELECT_MAX_MARKET_CAP="100000000000"
SELECT_MIN_TURNOVER="1"
SELECT_MAX_TURNOVER="18"
SELECT_MIN_PCT="-3"
SELECT_MAX_PCT="7"
SELECT_MIN_SCORE="55"

# 次日交易计划
PLAN_NO_CHASE_PCT="4"
PLAN_TAKE_PROFIT_1_PCT="4"
PLAN_TAKE_PROFIT_2_PCT="6"
PLAN_MAX_LOSS_PCT="3"
PLAN_TRAILING_START_PCT="4"
PLAN_TRAILING_DRAWDOWN_PCT="2"
PLAN_MAX_POSITION_PCT="50"
PLAN_TIME_STOP_DAYS="2"

# --------------------
# trade-manager 盘中执行
# --------------------
TRADE_MONITOR_ENABLED="true"

# 工作日每分钟触发；程序内部只在 A 股交易时段真正取行情。
TRADE_MONITOR_CRON="* * * * 1-5"

# 16:45 同步 stock-select 当天生成的明日重点计划。
TRADE_PLAN_SYNC_CRON="45 16 * * 1-5"
TRADE_MONITOR_TOP_COUNT="3"

# 手工录入已有持仓时的默认纪律。
TRADE_DEFAULT_STOP_PCT="3"
TRADE_DEFAULT_TAKE_PROFIT1_PCT="4"
TRADE_DEFAULT_TAKE_PROFIT2_PCT="6"
TRADE_DEFAULT_TRAILING_START_PCT="4"
TRADE_DEFAULT_TRAILING_DRAWDOWN_PCT="2"
TRADE_DEFAULT_TIME_STOP_DAYS="2"
