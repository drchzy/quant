# ==============================
# Quant 统一运行配置
# 复制为 web/config/.env 后修改
# ==============================

# ---------- 通用 ----------
TZ=Asia/Shanghai

# 宿主机持久化目录。相对路径以 docker-compose.yml 所在目录为基准。
RUNTIME_DIR=./web

# ---------- Web ----------
# Web 对外监听地址。0.0.0.0 表示局域网/外网可访问。
WEB_BIND_IP=0.0.0.0
WEB_PORT=8088

# Web 默认启用 Basic Auth。
# 首次启动默认：admin / quant123456
# 正式使用前请务必修改密码。
WEB_AUTH_ENABLED=true
WEB_USERNAME=admin
WEB_PASSWORD=quant123456

# ---------- 后端端口 ----------
# 默认只绑定宿主机回环地址，避免绕过 Web 登录直接访问后端 API。
BACKEND_BIND_IP=127.0.0.1
MARKET_DATA_PORT=8080
STOCK_SELECT_PORT=8090
TRADE_MANAGER_PORT=8091

# ---------- market-data ----------
SYNC_ENABLED=true
DAILY_SYNC_CRON=10 16 * * 1-5
EASTMONEY_TIMEOUT_MS=10000
EASTMONEY_PAGE_SIZE=500

# ---------- stock-select ----------
AUTO_SELECT_ENABLED=true
SELECT_CRON=40 16 * * 1-5

SELECT_TOP_COUNT=10
SELECT_MAIN_COUNT=3
SELECT_EXCLUDE_BSE=true
SELECT_EXCLUDE_STAR=true
SELECT_EXCLUDE_ST=true
SELECT_MIN_PRICE=3
SELECT_MIN_AMOUNT=100000000
SELECT_MIN_MARKET_CAP=2000000000
SELECT_MAX_MARKET_CAP=100000000000
SELECT_MIN_TURNOVER=1
SELECT_MAX_TURNOVER=18
SELECT_MIN_PCT=-3
SELECT_MAX_PCT=7
SELECT_MIN_SCORE=55

# ---------- 次日执行规则 ----------
PLAN_NO_CHASE_PCT=4
PLAN_TAKE_PROFIT_1_PCT=4
PLAN_TAKE_PROFIT_2_PCT=6
PLAN_MAX_LOSS_PCT=3
PLAN_TRAILING_START_PCT=4
PLAN_TRAILING_DRAWDOWN_PCT=2
PLAN_MAX_POSITION_PCT=50
PLAN_TIME_STOP_DAYS=2

# ---------- trade-manager ----------
TRADE_MONITOR_ENABLED=true
TRADE_MONITOR_CRON=* * * * 1-5
TRADE_PLAN_SYNC_CRON=45 16 * * 1-5
TRADE_MONITOR_TOP_COUNT=3

TRADE_DEFAULT_STOP_PCT=3
TRADE_DEFAULT_TAKE_PROFIT1_PCT=4
TRADE_DEFAULT_TAKE_PROFIT2_PCT=6
TRADE_DEFAULT_TRAILING_START_PCT=4
TRADE_DEFAULT_TRAILING_DRAWDOWN_PCT=2
TRADE_DEFAULT_TIME_STOP_DAYS=2

# ---------- Docker Hub 镜像 ----------
MARKET_DATA_IMAGE=drchzy/quant-market-data:latest
STOCK_SELECT_IMAGE=drchzy/quant-stock-select:latest
TRADE_MANAGER_IMAGE=drchzy/quant-trade-manager:latest
WEB_IMAGE=drchzy/quant-web:latest
