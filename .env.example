# 通用
TZ=Asia/Shanghai
WEB_PORT=8088

# market-data
HOST=0.0.0.0
PORT=8080
DATABASE_PATH=/app/data/market.duckdb
SYNC_ENABLED=true
DAILY_SYNC_CRON=10 16 * * 1-5
EASTMONEY_TIMEOUT_MS=10000
EASTMONEY_PAGE_SIZE=500

# stock-select
SELECT_DATABASE_PATH=/app/data/select.duckdb
MARKET_DATA_URL=http://market-data:8080
AUTO_SELECT_ENABLED=true
SELECT_CRON=40 16 * * 1-5

# 默认超短趋势过滤参数
SELECT_TOP_COUNT=10
SELECT_MAIN_COUNT=3
SELECT_EXCLUDE_BSE=true
SELECT_EXCLUDE_STAR=true
SELECT_EXCLUDE_ST=true
SELECT_MIN_PRICE=3
SELECT_MIN_AMOUNT=100000000
SELECT_MIN_MARKET_CAP=2000000000
SELECT_MAX_MARKET_CAP=100000000000
SELECT_MIN_TURNOVER=1
SELECT_MAX_TURNOVER=18
SELECT_MIN_PCT=-3
SELECT_MAX_PCT=7
SELECT_MIN_SCORE=55

# 次日执行规则
PLAN_NO_CHASE_PCT=4
PLAN_TAKE_PROFIT_1_PCT=4
PLAN_TAKE_PROFIT_2_PCT=6
PLAN_MAX_LOSS_PCT=3
PLAN_TRAILING_START_PCT=4
PLAN_TRAILING_DRAWDOWN_PCT=2
PLAN_MAX_POSITION_PCT=50
PLAN_TIME_STOP_DAYS=2

# Docker Hub 镜像
MARKET_DATA_IMAGE=drchzy/quant-market-data:latest
STOCK_SELECT_IMAGE=drchzy/quant-stock-select:latest
WEB_IMAGE=drchzy/quant-web:latest
